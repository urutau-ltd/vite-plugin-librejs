{
    "name": "@urutau-ltd/vite-plugin-librejs",
    "version": "1.0.1",
    "license": "AGPL-3.0-or-later",
    "exports": "./mod.ts",
    "nodeModulesDir": "auto",
    "tasks": {
        "check": "deno check",
        "fmt": "deno fmt --check",
        "lint": "deno lint",
        "test": "deno test -P"
    },
    "imports": {
        "@std/assert": "jsr:@std/assert@^1.0.19",
        "vite": "npm:vite@^8.3.0"
    },
    "publish": {
        "exclude": [
            "plugin_test.ts"
        ]
    },
    "fmt": {
        "useTabs": false,
        "lineWidth": 80,
        "indentWidth": 4,
        "semiColons": true,
        "proseWrap": "always",
        "exclude": [
            "node_modules"
        ]
    },
    "lint": {
        "rules": {
            "tags": ["recommended"],
            "include": [
                "no-explicit-any",
                "ban-untagged-todo",
                "ban-untagged-ignore",
                "eqeqeq",
                "explicit-function-return-type",
                "no-console",
                "guard-for-in",
                "no-const-assign",
                "no-eval",
                "no-self-compare",
                "no-throw-literal",
                "no-undef",
                "triple-slash-reference",
                "single-var-declarator",
                "no-slow-types"
            ]
        }
    },
    "permissions": {
        "default": {
            "read": false,
            "write": false,
            "net": false,
            "env": false,
            "run": false,
            "sys": false,
            "ffi": false,
            "import": false
        }
    },
    "lock": true,
    "allowScripts": {
        "deny": [
            "npm:*"
        ]
    }
}
